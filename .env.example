# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
#
# Every variable here is parsed and validated by src/lib/env.ts at startup.
# A missing or malformed value fails the build loudly instead of surfacing as
# `undefined` somewhere deep in a request handler.
# ---------------------------------------------------------------------------

# --- Server-only -----------------------------------------------------------
# These must NEVER be prefixed with NEXT_PUBLIC_. src/lib/env.ts throws if a
# server variable is read from client code.

# Where the catalog data comes from. "memory" uses the in-repo seed data.
CATALOG_SOURCE=memory

# Artificial latency (ms) applied to data-layer reads, so streaming, Suspense
# and loading states are actually observable in development. Set to 0 to disable.
CATALOG_LATENCY_MS=300

# --- Public (exposed to the browser) ---------------------------------------
# Inlined into the client bundle at build time. Never put a secret here.

# Canonical origin, used for metadataBase, sitemap, robots and OG image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
